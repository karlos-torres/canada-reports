{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "ReportsDatabase": "Server=localhost;Database=master;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Reports": [
    {
      "Key": "databases",
      "Name": "Databases",
      "Query": "SELECT name AS DatabaseName, create_date AS CreatedOn FROM sys.databases WHERE create_date >= @StartDate",
      "Parameters": [
        {
          "Key": "StartDate",
          "Label": "Created After",
          "ControlType": "date",
          "Required": false,
          "DefaultValue": "2000-01-01"
        }
      ]
    },
    {
      "Key": "tables",
      "Name": "Tables",
      "Query": "SELECT TOP (@TopCount) name AS TableName, create_date AS CreatedOn FROM sys.objects WHERE type = 'U' AND name LIKE '%' + @SearchText + '%' AND create_date >= @StartDate ORDER BY CASE WHEN @SortOrder = 'asc' THEN create_date END ASC, CASE WHEN @SortOrder = 'desc' THEN create_date END DESC",
      "Parameters": [
        {
          "Key": "TopCount",
          "Label": "Max Rows",
          "ControlType": "number",
          "Required": true,
          "DefaultValue": "200"
        },
        {
          "Key": "SearchText",
          "Label": "Table Name Contains",
          "ControlType": "textbox",
          "Required": false,
          "DefaultValue": ""
        },
        {
          "Key": "StartDate",
          "Label": "Created After",
          "ControlType": "date",
          "Required": false,
          "DefaultValue": "1900-01-01"
        },
        {
          "Key": "SortOrder",
          "Label": "Sort Order",
          "ControlType": "dropdown",
          "Required": true,
          "DefaultValue": "desc",
          "Options": [
            {
              "Value": "desc",
              "Label": "Newest First"
            },
            {
              "Value": "asc",
              "Label": "Oldest First"
            }
          ]
        }
      ]
    }
  ],
  "AllowedHosts": "*"
}
