@model canada_reports.Models.ReportPageViewModel

@{
    ViewData["Title"] = "Reports Dashboard";
}

<div class="row" id="report-dashboard" data-selected-report-key="@Model.SelectedReportKey">
    <aside class="col-md-3 mb-3">
        <div class="card">
            <div class="card-header">Dashboard</div>
            <div class="list-group list-group-flush">              
                    <a class="list-group-item list-group-item-action"
                       asp-action="dashboard"
                       asp-route-reportKey="dashboard">
                        Executed reports
                    </a>
            </div>
        </div>


        <div class="card margin-t-50">
            <div class="card-header">Reports</div>
            <div class="list-group list-group-flush">
                @foreach (var report in Model.Reports)
                {
                    <a class="list-group-item list-group-item-action @(Model.SelectedReportKey == report.Key ? "active" : "")"
                       asp-action="Index"
                       asp-route-reportKey="@report.Key">
                        @report.Name
                    </a>
                }
            </div>
        </div>
    </aside>
    <section class="col-md-9">
        <div class="d-flex justify-content-between align-items-center mb-2 gap-2 flex-wrap">
            <h2 class="h4 mb-0">@Model.SelectedReportName</h2>
            <div class="d-flex gap-2">
                <button id="run-report-btn" class="btn btn-primary" @(string.IsNullOrWhiteSpace(Model.SelectedReportKey) ? "disabled" : null)>
                    Run in background
                </button>
                <button id="refresh-runs-btn" class="btn btn-outline-secondary" type="button">Refresh</button>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="alert alert-danger">@Model.ErrorMessage</div>
        }
        else
        {
            <div id="run-feedback" class="alert alert-info d-none"></div>
            <div id="run-loading" class="d-none mb-3">
                <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                <span>Starting background run...</span>
            </div>

        }
    </section>
</div>
