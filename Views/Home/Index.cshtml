@model canada_reports.Models.ReportPageViewModel
@using System.Globalization

@{
    ViewData["Title"] = "Reports Dashboard";
    var routeValues = new Dictionary<string, string>
    {
        ["reportKey"] = Model.SelectedReportKey,
        ["pageSize"] = Model.PageSize.ToString(CultureInfo.InvariantCulture)
    };

    foreach (var parameter in Model.SelectedReportParameters)
    {
        if (Model.ParameterValues.TryGetValue(parameter.Key, out var value))
        {
            routeValues[$"param_{parameter.Key}"] = value;
        }
    }
}

<div class="row">
    <aside class="col-md-3 mb-3">
        <div class="card">
            <div class="card-header">Reports</div>
            <div class="list-group list-group-flush">
                @foreach (var report in Model.Reports)
                {
                    <a class="list-group-item list-group-item-action @(Model.SelectedReportKey == report.Key ? "active" : "")"
                       asp-action="Index"
                       asp-route-reportKey="@report.Key"
                       asp-route-page="1"
                       asp-route-pageSize="@Model.PageSize">
                        @report.Name
                    </a>
                }
            </div>
        </div>
    </aside>
    <section class="col-md-9">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h2 class="h4 mb-0">@Model.SelectedReportName</h2>
            @if (!string.IsNullOrWhiteSpace(Model.SelectedReportKey))
            {
                <a class="btn btn-success"
                   asp-action="Export"
                   asp-all-route-data="@routeValues">
                    Export to CSV
                </a>
            }
        </div>

        @if (Model.SelectedReportParameters.Count > 0)
        {
            <div class="card mb-3">
                <div class="card-header">Parameters</div>
                <div class="card-body">
                    <form method="get" asp-action="Index" class="row g-3">
                        <input type="hidden" name="reportKey" value="@Model.SelectedReportKey" />
                        <input type="hidden" name="page" value="1" />
                        <input type="hidden" name="pageSize" value="@Model.PageSize" />

                        @foreach (var parameter in Model.SelectedReportParameters)
                        {
                            Model.ParameterValues.TryGetValue(parameter.Key, out var currentValue);
                            <div class="col-md-6">
                                <label class="form-label" for="param_@parameter.Key">@parameter.Label</label>
                                @switch (parameter.ControlType.ToLowerInvariant())
                                {
                                    case "date":
                                        <input id="param_@parameter.Key"
                                               name="param_@parameter.Key"
                                               class="form-control"
                                               type="date"
                                               value="@currentValue"
                                               placeholder="@parameter.Placeholder"
                                               required="@parameter.Required" />
                                        break;
                                    case "number":
                                        <input id="param_@parameter.Key"
                                               name="param_@parameter.Key"
                                               class="form-control"
                                               type="number"
                                               step="any"
                                               value="@currentValue"
                                               placeholder="@parameter.Placeholder"
                                               required="@parameter.Required" />
                                        break;
                                    case "dropdown":
                                    case "select":
                                        <select id="param_@parameter.Key"
                                                name="param_@parameter.Key"
                                                class="form-select"
                                                required="@parameter.Required">
                                            @if (!parameter.Required)
                                            {
                                                <option value="">Select...</option>
                                            }
                                            @foreach (var option in parameter.Options)
                                            {
                                                var isSelected = string.Equals(option.Value, currentValue, StringComparison.Ordinal);
                                                <option value="@option.Value" selected="@isSelected">@option.Label</option>
                                            }
                                        </select>
                                        break;
                                    default:
                                        <input id="param_@parameter.Key"
                                               name="param_@parameter.Key"
                                               class="form-control"
                                               type="text"
                                               value="@currentValue"
                                               placeholder="@parameter.Placeholder"
                                               required="@parameter.Required" />
                                        break;
                                }
                            </div>
                        }

                        <div class="col-12">
                            <button type="submit" class="btn btn-primary">Apply</button>
                        </div>
                    </form>
                </div>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="alert alert-danger">@Model.ErrorMessage</div>
        }
        else if (Model.Columns.Count == 0)
        {
            <div class="alert alert-info">No data found for this report.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-bordered">
                    <thead>
                        <tr>
                            @foreach (var column in Model.Columns)
                            {
                                <th>@column</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Rows)
                        {
                            <tr>
                                @foreach (var cell in row)
                                {
                                    <td>@cell</td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <nav aria-label="Report pagination">
                <ul class="pagination">
                    <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-all-route-data="@routeValues"
                           asp-route-page="@(Model.Page - 1)">
                            Previous
                        </a>
                    </li>
                    <li class="page-item disabled">
                        <span class="page-link">Page @Model.Page of @Model.TotalPages</span>
                    </li>
                    <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-all-route-data="@routeValues"
                           asp-route-page="@(Model.Page + 1)">
                            Next
                        </a>
                    </li>
                </ul>
            </nav>
        }
    </section>
</div>
